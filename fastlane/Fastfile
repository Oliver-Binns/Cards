require "securerandom"

default_platform(:ios)

platform :ios do
  PROJECT = "Card Play.xcodeproj"
  WORKSPACE = "CardPlay.xcworkspace"
  SCHEME = "Card Play"
  TARGET = "Card Play"
  TEAM_ID = "Z86DH46P79"
  KEYCHAIN = "signing_temp"

  def app_identifier
    ENV.fetch("APP_IDENTIFIER", "uk.co.oliverbinns.cardplay.Card-Play")
  end

  # API_KEY is the raw contents of the App Store Connect API key (.p8).
  private_lane :load_app_store_connect_api_key do
    app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_API_ISSUER_ID"),
      key_content: ENV.fetch("API_KEY"),
      is_key_content_base64: false
    )

    lane_context[SharedValues::APP_STORE_CONNECT_API_KEY]
  end

  # GitHub-hosted runners have an empty keychain, so import the distribution
  # certificate into a temporary keychain for the duration of the build.
  private_lane :import_distribution_certificate do
    password = SecureRandom.hex

    create_keychain(
      name: KEYCHAIN,
      password: password,
      default_keychain: true,
      unlock: true,
      timeout: 3600
    )

    import_certificate(
      certificate_path: ENV.fetch("CERTIFICATE_PATH"),
      certificate_password: ENV.fetch("CERTIFICATE_PASSWORD"),
      keychain_name: KEYCHAIN,
      keychain_password: password
    )
  end

  private_lane :setup_distribution_signing do |options|
    get_provisioning_profile(
      api_key: options[:api_key],
      app_identifier: app_identifier,
      readonly: true
    )
    profile_name = lane_context[SharedValues::SIGH_NAME]

    update_code_signing_settings(
      path: PROJECT,
      use_automatic_signing: false,
      team_id: TEAM_ID,
      targets: [TARGET],
      build_configurations: "Release",
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name
    )

    { identifier: app_identifier, profile_name: profile_name }
  end

  private_lane :ensure_available_version do
    app = Spaceship::ConnectAPI::App.find(app_identifier)
    live_version = app.get_live_app_store_version

    current_version = get_version_number(xcodeproj: PROJECT, target: TARGET)
    version_parts = current_version.split(".").map(&:to_i)

    # A new version must be strictly greater than the version currently live
    # on the App Store. We only compare against the live version (not any
    # unreleased draft) so that repeated CI runs keep targeting the same
    # not-yet-released draft version rather than bumping past it every time.
    if live_version
      live_version_parts = live_version.version_string.split(".").map(&:to_i)
      if (version_parts <=> live_version_parts) <= 0
        version_parts = live_version_parts.dup
        version_parts[-1] += 1
      end
    end

    new_version = version_parts.join(".")

    if new_version != current_version
      UI.important("Version #{current_version} is not newer than the live App Store version. Bumping to #{new_version}.")

      project = Xcodeproj::Project.open("../#{PROJECT}")
      project.targets.each do |target|
        target.build_configurations.each do |config|
          config.build_settings["MARKETING_VERSION"] = new_version if config.build_settings["MARKETING_VERSION"]
        end
      end
      project.save
    end
  end

  desc "Build and upload to App Store and TestFlight"
  lane :release do
    api_key = load_app_store_connect_api_key
    import_distribution_certificate
    signing_profile = setup_distribution_signing(api_key: api_key)

    ensure_available_version
    version_number = get_version_number(xcodeproj: PROJECT, target: TARGET)

    build_number = latest_testflight_build_number(
      api_key: api_key,
      platform: "ios",
      app_identifier: app_identifier,
      version: version_number
    ).next.to_s
    increment_build_number(xcodeproj: PROJECT, build_number: build_number)

    build_app(
      workspace: WORKSPACE,
      scheme: SCHEME,
      export_method: "app-store",
      destination: "generic/platform=iOS",
      export_options: {
        provisioningProfiles: {
          signing_profile[:identifier] => signing_profile[:profile_name]
        }
      }
    )

    # Metadata and screenshots are only uploaded once they exist in fastlane/
    # (e.g. after `bundle exec fastlane deliver download_metadata`).
    upload_to_app_store(
      api_key: api_key,
      force: true,
      skip_metadata: !File.directory?("metadata"),
      skip_screenshots: !File.directory?("screenshots"),
      overwrite_screenshots: true,
      precheck_include_in_app_purchases: false
    )

    upload_to_testflight(
      api_key: api_key,
      distribute_only: true,
      app_identifier: app_identifier,
      app_version: version_number,
      build_number: build_number,
      distribute_external: true,
      groups: ["Public"],
      changelog: last_git_commit[:message],
      submit_beta_review: true,
      reject_build_waiting_for_review: false
    )
  end

  after_all do |lane|
    delete_keychain(name: KEYCHAIN) if lane == :release
  end

  error do |lane, exception|
    delete_keychain(name: KEYCHAIN) if lane == :release && File.exist?(File.expand_path("~/Library/Keychains/#{KEYCHAIN}-db"))
  end
end
